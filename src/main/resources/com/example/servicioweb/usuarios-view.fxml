<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.servicioweb.controller.UsuarioController">
   <children>
      <Label layoutX="37.0" layoutY="30.0" text="Consulta de usuarios - API REST">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="btnConsulta" layoutX="37.0" layoutY="70.0" mnemonicParsing="false" onAction="#consultarUsuarios" text="Consultar usuarios" />
      <Label fx:id="lblEstado" layoutX="171.0" layoutY="74.0" text="Presione Consultar usuarios" />
      <TableView fx:id="tblUsuario" layoutX="37.0" layoutY="123.0" prefHeight="200.0" prefWidth="538.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colUsername" prefWidth="75.0" text="Username" />
            <TableColumn fx:id="colCorreo" prefWidth="75.0" text="Correo" />
            <TableColumn fx:id="colTelefono" prefWidth="75.0" text="Teléfono" />
            <TableColumn fx:id="colCiudad" prefWidth="75.0" text="Ciudad " />
            <TableColumn fx:id="colEmpresa" prefWidth="75.0" text="Empresa" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
