<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.servicioweb.controller.CustomerController"
            prefHeight="400.0" prefWidth="600.0">


    <children>

        <Label layoutX="30.0" layoutY="25.0"
               text="Consulta de clientes - API REST">
            <font>
                <Font name="System Bold" size="18.0"/>
            </font>
        </Label>

        <Button fx:id="btnConsulta"
                layoutX="30.0"
                layoutY="65.0"
                mnemonicParsing="false"
                onAction="#consultarClientes"
                text="Consultar clientes"/>

        <Label fx:id="lblEstado"
               layoutX="200.0"
               layoutY="69.0"
               text="Presione Consultar clientes"/>

        <TableView fx:id="tblCustomers"
                   layoutX="20.0"
                   layoutY="110.0"
                   prefHeight="465.0"
                   prefWidth="960.0"
                   AnchorPane.topAnchor="110.0"
                   AnchorPane.bottomAnchor="25.0"
                   AnchorPane.leftAnchor="20.0"
                   AnchorPane.rightAnchor="20.0">

            <columns>

                <TableColumn fx:id="colId"
                             prefWidth="70.0"
                             text="ID"/>

                <TableColumn fx:id="colFirstName"
                             prefWidth="120.0"
                             text="Nombre"/>

                <TableColumn fx:id="colLastName"
                             prefWidth="120.0"
                             text="Apellido"/>

                <TableColumn fx:id="colEmail"
                             prefWidth="180.0"
                             text="Correo"/>

                <TableColumn fx:id="colPhone"
                             prefWidth="120.0"
                             text="Teléfono"/>

                <TableColumn fx:id="colDateOfBirth"
                             prefWidth="150.0"
                             text="Fecha nacimiento"/>

                <TableColumn fx:id="colCountry"
                             prefWidth="110.0"
                             text="País"/>

                <TableColumn fx:id="colCity"
                             prefWidth="110.0"
                             text="Ciudad"/>

                <TableColumn fx:id="colAddress"
                             prefWidth="160.0"
                             text="Dirección"/>

                <TableColumn fx:id="colAnnualIncome"
                             prefWidth="120.0"
                             text="Ingreso anual"/>

                <TableColumn fx:id="colCreditScore"
                             prefWidth="110.0"
                             text="Credit Score"/>

                <TableColumn fx:id="colUnpaidDebt"
                             prefWidth="130.0"
                             text="Deuda pendiente"/>

                <TableColumn fx:id="colUnpaidDebtAmount"
                             prefWidth="130.0"
                             text="Monto deuda"/>

                <TableColumn fx:id="colStatus"
                             prefWidth="100.0"
                             text="Estado"/>

                <TableColumn fx:id="colCreatedAt"
                             prefWidth="160.0"
                             text="Fecha creación"/>

                <TableColumn fx:id="colUpdatedAt"
                             prefWidth="170.0"
                             text="Última actualización"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>
